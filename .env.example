# Awaki — copy to .env (auto-loaded from the working directory when you run the binary).
# Shell-exported variables always win over values in this file.

# ── Required: Telegram bot chat ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_OWNER_ID=123456789

# ── Optional paths / logging ─────────────────────────────────────────────────
# AWAKI_DATA_DIR=C:\Users\you\.awaki
# AWAKI_WORK_DIR=C:\Users\you\projects\awaki-server
# LOG_LEVEL=info

# ── Optional LLM bootstrap (usually configure in Telegram instead) ───────────
# Prefer:
#   /provider_add name|protocol|base_url|api_key
#   /model_add provider|model_id|Display Name
#
# AWAKI_PROVIDER=custom
# AWAKI_MODEL=gpt-4o
# AWAKI_BASE_URL=https://openrouter.ai/api/v1
# AWAKI_API_KEY=sk-or-v1-...
# AWAKI_MAX_TOKENS=4096
# AWAKI_LLM_TIMEOUT=3m

# ── Optional: Telegrive-style user-account storage (MTProto) ─────────────────
# Create an app at https://my.telegram.org — then set:
# AWAKI_TG_API_ID=12345678
# AWAKI_TG_API_HASH=your_api_hash
# AWAKI_TG_PHONE=+2519xxxxxxxx
# AWAKI_TG_PASSWORD=
# AWAKI_TG_SESSION=
# AWAKI_TG_CODE_FILE=
# AWAKI_TG_CHANNEL=Awaki

# ── Optional: bot-mode storage channel (if not using user MTProto) ───────────
# AWAKI_STORAGE_CHAT_ID=

# ── Optional: scheduler ──────────────────────────────────────────────────────
# AWAKI_SCHEDULER_TASK_TIMEOUT=5m
# AWAKI_SCHEDULER_MAX_CONCURRENT=2

# ── Optional: transport (default telegram) ───────────────────────────────────
# AWAKI_TRANSPORT=telegram

# HTTP health (Koyeb/Render). Platforms set PORT automatically.
PORT=8000
# AWAKI_HTTP_PORT=8000

# Server-side conversation continuation (Gemini Interactions / OpenAI Responses). Default: true
# AWAKI_CONTINUATION=true

# ── Optional: remote HTTP triggers (same port as health) ─────────────────────
# When set, enables:
#   POST /hooks/agent     { "text": "...", "plan": false, "mode": "auto|queue|interrupt" }
#   POST /hooks/task      { "title": "...", "prompt": "...", "auto_start": true }
#   POST /hooks/schedule  { "schedule": "in 5m", "command": "...", "label": "optional" }
# Auth: header X-Awaki-Secret: <secret>  OR  Authorization: Bearer <secret>
# AWAKI_HOOK_SECRET=change-me-long-random

# Default permission mode for new chats: auto | ask | plan
# AWAKI_PERMISSION_MODE=auto

# --- Tool safety -----------------------------------------------------------
# Command guard for the bash tool: warn (default: block catastrophic commands,
# annotate risky ones) | block (refuse both) | off
# AWAKI_BASH_GUARD=warn
# Hide API keys/tokens from commands the agent runs: scrub (default) | inherit
# AWAKI_BASH_ENV=scrub
# Variables to keep anyway (comma separated), e.g. for git push over https
# AWAKI_BASH_ENV_PASSTHROUGH=GITHUB_TOKEN
# Extra directories send_file may send from (besides workspace and temp)
# AWAKI_SEND_FILE_ROOTS=/data/exports
# AWAKI_SEND_MAX_MB=50
